# Vercel env vars for the sign-then-pay subscription flow.
# Set these in Vercel Dashboard -> Project -> Settings -> Environment Variables.
# NEVER commit real values. Copy this file to .env.local for local testing only.

# Stripe secret key (live mode):
#   Stripe Dashboard -> Developers -> API keys -> Secret key -> Reveal
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret:
#   Stripe Dashboard -> Developers -> Webhooks -> Add endpoint
#   URL: https://www.lw-propertysolutions.com/api/stripe-webhook
#   Events: checkout.session.completed
#   After creating it, copy the "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend API key (for emailing the signed agreement):
#   https://resend.com -> API Keys -> Create API Key
#   Sending domain lw-propertysolutions.com must be verified in Resend
#   (Resend -> Domains -> Add Domain, then add the SPF/DKIM TXT records
#   it shows to the domain's DNS at the registrar).
RESEND_API_KEY=re_...

# Stripe Price IDs for the 6 subscription prices
# (Stripe Dashboard -> Products -> open each product -> Pricing -> copy the
# ID, it looks like price_1AbC...):
#   Basic $99/mo, Basic $1,069/yr, Standard $199/mo, Standard $2,149/yr,
#   Premium $299/mo, Premium $3,229/yr
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_STD_MONTHLY=price_...
STRIPE_PRICE_STD_ANNUAL=price_...
STRIPE_PRICE_PRE_MONTHLY=price_...
STRIPE_PRICE_PRE_ANNUAL=price_...
